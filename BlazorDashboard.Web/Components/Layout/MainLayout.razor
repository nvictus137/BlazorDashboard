@inherits LayoutComponentBase
@inject NavigationManager Navigation

<a class="visually-hidden-focusable skip-link" href="@SkipLink">Skip to content</a>

<div class="dashboard-shell">
    <aside id="dashboard-sidebar" class="dashboard-sidebar offcanvas-lg offcanvas-start"
           tabindex="-1" aria-labelledby="dashboard-sidebar-title">
        <NavMenu />
    </aside>

    <div class="dashboard-workspace">
        <header class="dashboard-topbar">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-outline-secondary d-lg-none" type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#dashboard-sidebar"
                        aria-controls="dashboard-sidebar" aria-label="Open navigation">
                    <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <path d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
                <span class="workspace-title">Operations workspace</span>
            </div>
            <span class="workspace-badge"><span aria-hidden="true"></span> Demo workspace</span>
        </header>

        <main id="dashboard-main" class="dashboard-main" tabindex="-1">
            @Body
        </main>

        <footer class="dashboard-footer">
            <strong>BlazorDashboard</strong>
            <span>.NET 10 · Aspire</span>
        </footer>
    </div>
</div>

<div id="blazor-error-ui" data-nosnippet role="alert">
    The dashboard encountered an unexpected error.
    <a href="" class="reload">Reload</a>
    <button type="button" class="dismiss btn-close" aria-label="Dismiss"></button>
</div>

@code {
    private string SkipLink => new Uri(Navigation.Uri).GetLeftPart(UriPartial.Query) + "#dashboard-main";
}
