@page "/403"
@using BlazorDashboard.SharedWeb

    <ContentHeader>
        <Header>
            <BlazorDashboard.SharedWeb.PageTitle Title="403 Error Page" />
        </Header>
    </ContentHeader>
    <ContentMain>
        <div class="error-page">
            <h2 class="headline text-warning"> 403</h2>

            <div class="error-content">
                <h3><i class="fas fa-exclamation-triangle text-warning"></i> Oops! Action Forbidden.</h3>

                <p>
                    You do not have access rights to the content; that is, it is unauthorized, so the server is refusing to give the requested resource.
                    Meanwhile, you may <a href="./">return to dashboard</a> or try using the search form.
                </p>

                <form class="search-form">
                    <div class="input-group">
                        <input type="text" name="search" class="form-control" placeholder="Search">

                        <div class="input-group-append">
                            <button type="submit" name="submit" class="btn btn-warning">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                    </div>
                    <!-- /.input-group -->
                </form>
            </div>
            <!-- /.error-content -->
        </div>
    </ContentMain>